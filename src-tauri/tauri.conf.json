{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Desktop Client",
  "version": "0.1.0",
  "identifier": "com.nikitamensky.ai-desktop-client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "AI Desktop Client", "width": 900, "height": 650 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420",
      "capabilities": ["main"]
    }
  },
  "bundle": { "active": true }
}
