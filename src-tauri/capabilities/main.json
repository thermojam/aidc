{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Only the main chat window may access local history and mock generation.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-list-history",
    "allow-start-mock-generation",
    "allow-retry-mock-generation",
    "allow-select-branch",
    "allow-stop-generation",
    "allow-save-key",
    "allow-delete-key",
    "allow-key-status",
    "allow-create-backup"
  ]
}
