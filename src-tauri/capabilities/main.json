{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Only the main chat window may access local history and mock generation.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-list-history",
    "allow-list-conversations",
    "allow-search-conversations",
    "allow-set-conversation-pinned",
    "allow-list-projects",
    "allow-create-project",
    "allow-rename-project",
    "allow-archive-project",
    "allow-move-conversation",
    "allow-list-project-materials",
    "allow-save-project-material",
    "allow-choose-project-folder",
    "allow-list-project-folder",
    "allow-preview-project-file",
    "allow-save-project-folder-material",
    "allow-create-conversation",
    "allow-rename-conversation",
    "allow-archive-conversation",
    "allow-start-mock-generation",
    "allow-retry-mock-generation",
    "allow-start-generation",
    "allow-retry-generation",
    "allow-select-branch",
    "allow-stop-generation",
    "allow-save-key",
    "allow-delete-key",
    "allow-key-status",
    "allow-create-backup",
    "allow-list-backups",
    "allow-restore-backup",
    "allow-pick-text-attachment",
    "allow-remove-text-attachment",
    "allow-list-models",
    "allow-list-model-categories",
    "allow-set-model-category",
    "allow-refresh-models",
    "allow-preview-context",
    "allow-create-artifact",
    "allow-export-artifact"
  ]
}
